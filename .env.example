# DMarket API credentials — create them at https://dmarket.com (Account > Trading API)
DMARKET_PUBLIC_KEY=your_public_key_here
DMARKET_SECRET_KEY=your_secret_key_here

# Set to true to run the full pipeline against the live API without placing,
# editing, or deleting any orders/offers (mutating calls are logged instead).
DRY_RUN=true
